<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>AotSmoke</AssemblyName>
    <RootNamespace>DataProofsDotnet.Tools.AotSmoke</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The tool's own code is held to the same trim/AOT/single-file analyzer bar as the packages
         (NFR-7): any reflection-based serializer call in this tool is a compile error. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- Itemize third-party ILC warnings in the publish log instead of one collapsed IL2104/IL3053 line
         per assembly, so the AC-12 scan can match each warning against known-il-warnings.txt by member. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- The ILCompiler inherits the repo-wide TreatWarningsAsErrors by default, which turns the known
         third-party warnings (Newtonsoft.Json's unreachable `dynamic` support, pulled in by
         dotNetRdf.Core) and the IlCanary warnings into publish errors. They are reported, not fatal:
         scan-il-warnings.sh decides, and it fails on any IL warning not on known-il-warnings.txt and on
         a log without the canary. The Roslyn analyzers on this tool's own code stay errors. -->
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    PublishAot is deliberately NOT set here. CI and local runs pass it on the command line
    (`dotnet publish -c Release -r <rid> -p:PublishAot=true`) so that:
      * an ordinary `dotnet restore DataProofsDotnet.sln` does not download the ILCompiler packages
        for every contributor and every CI job that merely builds the solution; and
      * `dotnet run` on this project stays a true JIT baseline — in a project that sets PublishAot the
        SDK turns JsonSerializer.IsReflectionEnabledByDefault off even under `dotnet run`, which would
        make the "JIT with reflection" leg of the four-way comparison impossible.
  -->

  <ItemGroup>
    <!-- file-based-app/aot-smoke.cs is a .NET 10 file-based program (#: directives) that references this
         project; it is run with `dotnet run <file>.cs`, never compiled as part of this project. -->
    <Compile Remove="file-based-app/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DataProofsDotnet.Core/DataProofsDotnet.Core.csproj" />
    <ProjectReference Include="../../src/DataProofsDotnet.Jose/DataProofsDotnet.Jose.csproj" />
    <ProjectReference Include="../../src/DataProofsDotnet.Cose/DataProofsDotnet.Cose.csproj" />
    <ProjectReference Include="../../src/DataProofsDotnet.Rdfc/DataProofsDotnet.Rdfc.csproj" />
    <ProjectReference Include="../../src/DataProofsDotnet.Legacy/DataProofsDotnet.Legacy.csproj" />
    <ProjectReference Include="../../src/DataProofsDotnet.Extensions.DependencyInjection/DataProofsDotnet.Extensions.DependencyInjection.csproj" />
    <!-- The concrete container that hosts AddDataProofs (CPM-pinned in Directory.Packages.props). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
